---
import Layout from "../layouts/Layout.astro";
import Carousel from "../components/Carousel.astro";

const galleryImages = [
  {
    type: "video",
    src: "/videos/videointroduccion.mp4",
    alt: "Video de las instalaciones",
  },
  {
    type: "image",
    src: "/images/Dr.yulianagiraldo.jpg",
    alt: "Instalaciones Centro Estético 1",
  },
];

const categories = [
  {
    name: "Bioestimuladores de Colágeno",
    description: "Tratamientos para recuperar la firmeza y elasticidad natural de la piel, estimulando la producción de colágeno.",
    icon: "✨",
    services: [
      "Sculptra",
      "Radiesse Plus",
      "Radiesse Clasic",
      "Harmonyca",
      "Juvelook Soft",
      "Juvelook Volume"
    ]
  },
  {
    name: "Toxina Botulínica",
    description: "Prevención y suavización de líneas de expresión para un rostro relajado y rejuvenecido.",
    icon: "💉",
    services: [
      "Botox Rostro",
      "Botox Hiperhidrosis",
      "Botox Bruxismo (Maseteros)",
      "Botox Cuello o Nefertiti"
    ]
  },
  {
    name: "Ácido Hialurónico",
    description: "Hidratación profunda, perfilamiento y reposición de volumen para armonizar tus rasgos.",
    icon: "💧",
    services: [
      "Labios",
      "Pómulos o puntos de sostén",
      "Código de barras",
      "Mentón",
      "Ojeras",
      "Surcos nasogenianos",
      "Líneas de marioneta",
      "Hidratación profunda (Restylane-Belotero Revive)",
      "Profhilo (Hidratación cuello / rostro)",
      "Novacutan Biopro",
      "Skinvive (Hidratación)"
    ]
  },
  {
