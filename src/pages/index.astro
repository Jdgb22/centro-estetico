      "Peeling luminoso + mascarilla",
      "Peeling químico (despigmentante - acné)",
      "Peeling ojeras",
      "Cosmelan",
      "Peeling de zona íntima",
      "Hilos mono PDO",
      "Enzimas recombinantes (PB Serum 1ra y 2da generación)",
      "Hialuronidasa (retiro de ácido hialurónico)",
      "Limpieza facial profunda",
      "Alidya (manejo de celulitis)",
      "Aqualyx (lipolítico destrucción de grasa)",
      "Escleroterapia",
      "Retiro de lesiones benignas / Cauterización de verrugas y lunares"
    ]
  },
  {
    name: "Ultraformer",
    description: "Tecnología HIFU para tensado de la piel, reducción de grasa localizada y efecto lifting sin cirugía.",
    icon: "⚡",
    services: [
      "Banco de colágeno",
      "Ultralips (labios)",
      "Ultrabur (poros dilatados)",
      "Fox Eyes",
      "Papada (grasa submentón)",
      "Full face (perfiles 1, 2 y 3)",
      "Corporal (abdomen, preaxilar, cuello, escote, muslos, brazos)",
      "Tensado focalizado (pómulos, código de barras, párpados, frente, surco nasolabial)"
    ]
  },
  {
    name: "Consulta",
    description: "Valoración profesional especializada para diseñar tu plan de tratamiento personalizado.",
    icon: "👩‍⚕️",
    services: [
      "Consulta médica"
    ]
  }
];

const benefits = [
  "Profesionales certificadas en estética avanzada.",
  "Protocolos personalizados según tipo de piel y objetivo.",
  "Equipos de última generación y productos dermatológicos.",
  "Ambiente cálido, privado y orientado al bienestar.",
];

const testimonials = [
  {
    author: "Ana Maria",
    text: "Confie en el plan antes de ver el resultado",
  },
  {
    name: "Natalia",
    text: "Me encantó la asesoría personalizada, entendieron exactamente lo que buscaba.",
  },
  {
    name: "Laura Giraldo",
    text: "Me daba pánico perder mi expresión o verme artificial. La doctora me explicó la anatomía de mi rostro y me propuso un plan sutil. Hoy me veo descansada y completamente yo.",
  },
  {
    name: "Carolina R",
    text: "Fui pidiendo un procedimiento de moda y me dijo con total honestidad que no era para mí. Ese criterio médico y ético vale más que cualquier catálogo de opciones.",
  },
  {
    name: "Valentina Gomez",
    text: "No intentó venderme tratamientos que no necesitaba; me escuchó y me dio calma desde la primera cita. Ver los resultados respetando mi estructura facial fue lo mejor.",
  },
  {
    name: "Marcela",
    text: "Mi rostro siempre lucía cansado, incluso al despertar. No me prometió milagros, me trazó una ruta clara. La tranquilidad de estar en manos expertas no se comparNo intentó venderme tratamientos que no necesitaba; me escuchó y me dio calma desde la primera cita. Ver los resultados respetando mi estructura facial fue lo mejor.",
  },
];
---

<Layout
  title="Dra. Yuliana Giraldo | Medica estetica"
  description="Centro estético especializado en tratamientos faciales, corporales y bienestar integral en un espacio profesional y acogedor."
>
  <main class="min-h-screen">
    <header
      class="sticky top-0 z-20 border-b border-sand/60 bg-ivory/90 backdrop-blur"
    >
      <div
        class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4"
      >
        <p
          class="font-heading text-lg font-semibold tracking-tight text-champagne"
        >
          Dra. Yuliana Giraldo
        </p>
        <nav
          class="hidden items-center gap-6 text-sm font-medium text-taupe md:flex"
        >
          <a href="#servicios" class="transition hover:text-champagne"
            >Servicios</a
          >
          <a href="#beneficios" class="transition hover:text-champagne"
            >Beneficios</a
          >
          <a href="#testimonios" class="transition hover:text-champagne"
            >Testimonios</a
          >
          <a href="#contacto" class="transition hover:text-champagne"
            >Contacto</a
          >
        </nav>
        <a
          href="#contacto"
          class="rounded-full bg-champagne px-4 py-2 text-sm font-semibold text-pure shadow-soft transition hover:bg-terracotta"
        >
          Reserva tu cita
        </a>
      </div>
    </header>

    <section
      id="galeria"
      class="mx-auto max-w-6xl px-6 pt-10 pb-16 md:pt-14 md:pb-20"
    >
      <div class="mb-10 text-center">
        <p class="text-sm font-semibold uppercase tracking-wide text-champagne">
          Nuestras Instalaciones
        </p>
        <h2 class="font-heading mt-2 text-3xl font-bold text-mocha">
          Un espacio pensado para ti
        </h2>
        <p class="mt-4 text-taupe max-w-2xl mx-auto">
          Descubre un ambiente diseñado especialmente para tu confort y
          relajación. Equipado con la mejor tecnología para tus tratamientos.
        </p>
      </div>
      <Carousel
        images={galleryImages as unknown as {
          type?: "video" | "image";
          src: string;
          alt?: string;
        }[]}
      />
    </section>

    <section
      class="relative overflow-hidden bg-gradient-to-br from-sand via-ivory to-nude/30"
    >
      <div
        class="absolute -top-24 -right-16 h-64 w-64 rounded-full bg-champagne/30 blur-3xl"
      >
      </div>
      <div
        class="absolute -bottom-20 -left-16 h-72 w-72 rounded-full bg-nude/30 blur-3xl"
      >
      </div>
      <div
        class="relative mx-auto grid max-w-6xl gap-10 px-6 py-20 md:grid-cols-2 md:py-28"
      >
        <div class="space-y-6">
          <p
            class="inline-flex rounded-full border border-champagne/40 bg-pure/80 px-4 py-1 text-sm font-medium text-champagne"
          >
            Belleza consciente y resultados visibles
          </p>
          <h1
            class="font-heading text-4xl font-bold tracking-tight text-mocha md:text-5xl"
          >
            Realza tu belleza natural en un espacio de cuidado profesional
          </h1>
          <p class="max-w-xl text-lg text-taupe">
            Combinamos tecnología estética, técnicas especializadas y atención
            personalizada para que te sientas bien por dentro y por fuera.
          </p>
          <div class="flex flex-wrap items-center gap-4">
            <a
              href="#servicios"
              class="rounded-full bg-champagne px-6 py-3 text-sm font-semibold text-pure transition hover:bg-terracotta"
            >
              Ver tratamientos
            </a>
            <a
              href="#contacto"
              class="rounded-full border border-champagne px-6 py-3 text-sm font-semibold text-mocha transition hover:bg-sand"
            >
              Solicitar evaluación
            </a>
          </div>
        </div>
        <div
          class="rounded-luxury border border-sand/70 bg-pure/80 p-8 shadow-xl shadow-sand"
        >
          <h2 class="font-heading text-xl font-semibold text-mocha">
            Plan de bienvenida
          </h2>
          <p class="mt-3 text-taupe">
            Primera visita con diagnóstico facial + asesoría de rutina diaria.
          </p>
          <div class="mt-6 rounded-2xl bg-sand p-5">
            <p class="text-sm font-medium text-champagne">Promoción del mes</p>
            <p class="mt-1 text-3xl font-bold text-mocha">$39.900</p>
            <p class="text-sm text-terracotta">
              Cupos limitados para nuevas clientas.
            </p>
          </div>
          <ul class="mt-6 space-y-3 text-sm text-taupe">
            <li>✓ Valoración personalizada sin costo adicional.</li>
            <li>✓ Recomendación de tratamiento y frecuencia ideal.</li>
            <li>✓ Seguimiento posterior de resultados.</li>
          </ul>
        </div>
      </div>
    </section>

    <section id="servicios" class="mx-auto max-w-6xl px-6 py-16 md:py-20">
      <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p
            class="text-sm font-semibold uppercase tracking-wide text-champagne"
          >
            Categorías de Tratamientos
          </p>
          <h2 class="font-heading mt-2 text-3xl font-bold text-mocha">
            Soluciones diseñadas para ti
          </h2>
        </div>
        <p class="max-w-lg text-sm text-taupe">
          Cada sesión comienza con una evaluación integral para adaptar el protocolo a
          tus necesidades específicas y garantizar los mejores resultados.
        </p>
      </div>
      <div class="mx-auto max-w-3xl space-y-4">
        {
          categories.map((category) => (
            <details class="group rounded-2xl border border-sand bg-pure shadow-sm [&_summary::-webkit-details-marker]:hidden">
              <summary class="flex cursor-pointer items-start justify-between gap-4 p-6 text-mocha transition hover:bg-sand/30">
                <div class="flex items-start gap-4">
                  <span class="text-2xl mt-1" aria-hidden="true">{category.icon}</span>
                  <div>
                    <h3 class="font-heading text-lg font-semibold">
                      {category.name}
                    </h3>
                    <p class="mt-1 text-sm text-taupe pr-4">
                      {category.description}
                    </p>
                  </div>
                </div>
                <span class="mt-1 flex-shrink-0 rounded-full bg-sand/50 p-2 text-champagne transition duration-300 group-open:-rotate-180">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="h-5 w-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                  </svg>
                </span>
              </summary>
              <div class="border-t border-sand/50 p-6 px-6 sm:px-14">
                <ul class="grid gap-3 sm:grid-cols-2">
                  {category.services.map((service) => (
                    <li class="flex items-start gap-2 text-taupe text-sm">
                      <span class="mt-0.5 text-champagne">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4">
                          <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
                        </svg>
                      </span>
                      {service}
                    </li>
                  ))}
                </ul>
              </div>
            </details>
          ))
        }
      </div>
    </section>

    <section id="beneficios" class="border-y border-sand bg-pure/70">
      <div class="mx-auto max-w-6xl px-6 py-16 md:py-20">
        <div class="grid gap-10 md:grid-cols-[1.2fr_1fr]">
          <div>
            <p
              class="text-sm font-semibold uppercase tracking-wide text-champagne"
            >
              ¿Por qué elegirnos?
            </p>
            <h2 class="font-heading mt-2 text-3xl font-bold text-mocha">
              Tu bienestar es parte esencial de cada sesión
            </h2>
            <ul class="mt-6 space-y-4 text-taupe">
              {
                benefits.map((benefit) => (
                  <li class="flex gap-3">
                    <span class="text-champagne">●</span>
                    {benefit}
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="rounded-luxury bg-mocha p-8 text-pure shadow-xl">
            <p
              class="text-sm font-semibold uppercase tracking-wide text-champagne"
            >
              Horarios
            </p>
            <p class="mt-3 text-lg">Lunes a viernes:</p>
            <p class="mt-3 text-lg">9:00 - 5:30 PM</p>
            <p class="mt-6 text-sm text-sand">
              Atención con cita previa para garantizar tiempos dedicados y una
              experiencia personalizada.
            </p>
          </div>
        </div>
      </div>
    </section>
    <section id="testimonios" class="mx-auto max-w-6xl px-6 py-16 md:py-20">
      <p class="text-sm font-semibold uppercase tracking-wide text-champagne">
        Testimonios
      </p>
      <h2 class="font-heading mt-2 text-3xl font-bold text-mocha">
        Lo que dicen nuestras clientas
      </h2>
      <div class="mt-8 grid gap-5 md:grid-cols-3">
        {
          testimonials.map((testimonial) => (
            <blockquote class="rounded-2xl border border-sand bg-pure p-6 shadow-soft">
              <p class="text-taupe">"{testimonial.text}"</p>
              <footer class="mt-4 text-sm font-semibold text-terracotta">
                {testimonial.name}
              </footer>
            </blockquote>
          ))
        }
      </div>
    </section>

    <section id="contacto" class="bg-mocha text-pure">
      <div
        class="mx-auto grid max-w-6xl gap-10 px-6 py-16 md:grid-cols-2 md:py-20"
      >
        <div>
          <p
            class="text-sm font-semibold uppercase tracking-wide text-champagne"
          >
            Contacto y reservas
          </p>
          <h2 class="font-heading mt-2 text-3xl font-bold">
            Agenda tu próxima sesión
          </h2>
          <p class="mt-4 max-w-md text-sand">
            Escríbenos para recomendarte el tratamiento ideal según tus
            objetivos estéticos y de bienestar.
          </p>
        </div>
        <div class="space-y-4 rounded-2xl bg-pure/10 p-6 backdrop-blur">
          <p>
            <span class="font-semibold text-champagne">WhatsApp:</span> +57 324 367
            5031
          </p>
          <p>
            <span class="font-semibold text-champagne">Email:</span> dra.yulianagiraldo.medestetica@gmail.com
          </p>
          <p>
            <span class="font-semibold text-champagne">Dirección:</span> Torre Médica
            Oviedo – Consultorio 691 Medellín Colombia - Barrio Poblado
          </p>
          <a
            href="whatsapp://send?phone=+573243675031"
            class="mt-3 inline-flex rounded-full bg-champagne px-5 py-2 text-sm font-semibold text-mocha transition hover:bg-terracotta hover:text-pure"
          >
            Quiero agendar
          </a>
        </div>
      </div>
    </section>

    <footer
      class="border-t border-champagne/30 bg-mocha px-6 py-5 text-center text-sm text-sand"
    >
      © {new Date().getFullYear()} Dra. Yuliana Giraldo Medica Estetica. Todos los
      derechos reservados.
      <a
        href="https://www.instagram.com/dra.yulianagiraldom/"
        class="text-champagne">Instagram</a
      >
      <a
        href="https://www.tiktok.com/@dra.yulianagiraldom"
        class="text-champagne">TikTok</a
      >
      <a href="whatsapp://send?phone=+573243675031" class="text-champagne"
        >WhatsApp</a
      >
    </footer>
  </main>
</Layout>
