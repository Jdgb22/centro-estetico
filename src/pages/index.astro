          Cada sesión comienza con una evaluación integral para adaptar el
          protocolo a tus necesidades específicas y garantizar los mejores
          resultados.
        </p>
      </div>
      <div class="mx-auto max-w-3xl space-y-4">
        {
          categories.map((category) => (
            <details
              name="services"
              class="service-accordion group rounded-2xl border border-sand bg-pure shadow-sm [&_summary::-webkit-details-marker]:hidden"
            >
              <summary class="flex cursor-pointer items-start justify-between gap-4 p-6 text-mocha transition hover:bg-sand/30">
                <div class="flex items-start gap-4">
                  <span class="text-2xl mt-1" aria-hidden="true">
                    {category.icon}
                  </span>
                  <div>
                    <h3 class="font-heading text-lg font-semibold">
                      {category.name}
                    </h3>
                    <p class="mt-1 text-sm text-taupe pr-4">
                      {category.description}
                    </p>
                  </div>
                </div>
                <span class="mt-1 flex-shrink-0 rounded-full bg-sand/50 p-2 text-champagne transition duration-300 group-open:-rotate-180">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="2.5"
                    stroke="currentColor"
                    class="h-5 w-5"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M19.5 8.25l-7.5 7.5-7.5-7.5"
                    />
                  </svg>
                </span>
              </summary>
              <div class="border-t border-sand/50 p-6 px-6 sm:px-14">
                <ul class="grid gap-3 sm:grid-cols-2">
                  {category.services.map((service) => (
                    <li class="flex items-start gap-2 text-taupe text-sm">
                      <span class="mt-0.5 text-champagne">
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 20 20"
                          fill="currentColor"
                          class="h-4 w-4"
                        >
                          <path
                            fill-rule="evenodd"
                            d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z"
                            clip-rule="evenodd"
                          />
                        </svg>
                      </span>
                      {service}
                    </li>
                  ))}
                </ul>
              </div>
            </details>
          ))
        }
      </div>
    </section>

    <!-- Nueva Sección Ultraformer -->
    <section id="tecnologia-ultraformer" class="relative overflow-hidden bg-sand/10 py-16 md:py-24">
      <div class="mx-auto max-w-6xl px-6">
        <div class="grid gap-12 md:grid-cols-2 items-center">
