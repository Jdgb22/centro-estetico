            <div
              class="rounded-2xl bg-pure/90 px-5 py-3 backdrop-blur-md shadow-sm"
            >
              <p class="text-xl font-heading font-bold text-mocha">
                Dra. Yuliana Giraldo
              </p>
              <p class="text-sm font-medium text-taupe">
                Medicina Estética Integral
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="servicios" class="mx-auto max-w-6xl px-6 py-16 md:py-20">
      <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p
            class="text-sm font-semibold uppercase tracking-wide text-champagne"
          >
            Categorías de Tratamientos
          </p>
          <h2 class="font-heading mt-2 text-3xl font-bold text-mocha">
            Soluciones diseñadas para ti
          </h2>
        </div>
