      "Nanopore facial (rostro y cuello)",
      "Exosomas capilar",
      "Exosomas facial",
      "Polinucleótidos (ADN de salmón)",
      "NCTF 135A",
      "Hyboost (biorevitalizante)",
      "RRS HA Eyes",
      "Plasma rico en plaquetas (PRP)",
      "Fibroblastos",
      "Biobanco"
    ]
  },
  {
    name: "Peelings y Otros Tratamientos",
    description: "Renovación celular, despigmentación y soluciones integrales para diversas necesidades estéticas.",
