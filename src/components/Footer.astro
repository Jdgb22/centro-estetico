---
interface Props {
	siteName?: string;
}

const { siteName = 'Lúmina' } = Astro.props;

const quickLinks = [
	{ href: '#servicios', label: 'Servicios' },
	{ href: '#beneficios', label: 'Beneficios' },
	{ href: '#testimonios', label: 'Testimonios' },
	{ href: '#contacto', label: 'Contacto' },
];

const services = [
	'Limpieza facial',
	'Radiofrecuencia',
	'Maderoterapia',
	'Depilación láser',
];

const schedule = [
	{ day: 'Lunes - Viernes', hours: '9:00 - 19:00' },
	{ day: 'Sábados', hours: '9:00 - 14:00' },
	{ day: 'Domingos', hours: 'Cerrado' },
];
---

<footer class="relative overflow-hidden bg-mocha text-sand/90">
	<!-- Decorative top border -->
	<div class="absolute top-0 left-0 h-1 w-full bg-gradient-to-r from-transparent via-champagne/60 to-transparent"></div>

	<!-- Decorative orb -->
	<div class="absolute -bottom-32 -right-32 h-64 w-64 rounded-full bg-champagne/5 blur-3xl"></div>

	<!-- Main footer content -->
	<div class="relative mx-auto max-w-6xl px-6 pt-16 pb-8">
		<div class="grid gap-12 md:grid-cols-2 lg:grid-cols-4">
			<!-- Brand Column -->
			<div class="lg:col-span-1">
				<div class="flex items-center gap-2">
					<span class="flex h-10 w-10 items-center justify-center rounded-full bg-champagne text-pure text-sm font-bold shadow-soft">
						L
					</span>
					<span class="font-heading text-xl font-semibold text-pure">{siteName}</span>
				</div>
				<p class="mt-4 max-w-xs text-sm leading-relaxed text-sand/70">
					Centro estético especializado en realzar tu belleza natural con tecnología avanzada y atención personalizada.
				</p>

				<!-- Social Links -->
				<div class="mt-6 flex items-center gap-3">
					<a href="#" class="group flex h-10 w-10 items-center justify-center rounded-xl bg-pure/8 text-sand/60 transition-all duration-300 hover:bg-champagne hover:text-pure" aria-label="Instagram">
						<svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
							<rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
							<path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
							<line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
						</svg>
					</a>
					<a href="#" class="group flex h-10 w-10 items-center justify-center rounded-xl bg-pure/8 text-sand/60 transition-all duration-300 hover:bg-champagne hover:text-pure" aria-label="Facebook">
						<svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
							<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
						</svg>
					</a>
					<a href="#" class="group flex h-10 w-10 items-center justify-center rounded-xl bg-pure/8 text-sand/60 transition-all duration-300 hover:bg-champagne hover:text-pure" aria-label="WhatsApp">
						<svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
							<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"></path>
						</svg>
					</a>
				</div>
			</div>

			<!-- Quick Links -->
			<div>
				<h3 class="text-sm font-semibold uppercase tracking-wider text-champagne">Navegación</h3>
				<ul class="mt-5 space-y-3">
					{quickLinks.map((link) => (
						<li>
							<a href={link.href} class="group inline-flex items-center gap-2 text-sm text-sand/70 transition-colors duration-300 hover:text-champagne">
								<span class="h-px w-0 bg-champagne transition-all duration-300 group-hover:w-3"></span>
								{link.label}
							</a>
						</li>
					))}
				</ul>
			</div>

			<!-- Services -->
			<div>
				<h3 class="text-sm font-semibold uppercase tracking-wider text-champagne">Tratamientos</h3>
				<ul class="mt-5 space-y-3">
					{services.map((service) => (
						<li>
							<a href="#servicios" class="group inline-flex items-center gap-2 text-sm text-sand/70 transition-colors duration-300 hover:text-champagne">
								<span class="h-px w-0 bg-champagne transition-all duration-300 group-hover:w-3"></span>
								{service}
							</a>
						</li>
					))}
				</ul>
			</div>

			<!-- Schedule -->
			<div>
				<h3 class="text-sm font-semibold uppercase tracking-wider text-champagne">Horarios</h3>
				<ul class="mt-5 space-y-3">
					{schedule.map((item) => (
						<li class="text-sm">
							<span class="block font-medium text-sand/90">{item.day}</span>
							<span class="text-sand/60">{item.hours}</span>
						</li>
					))}
				</ul>

				<!-- Location -->
				<div class="mt-6 flex items-start gap-3 rounded-xl bg-pure/5 p-3">
					<svg class="mt-0.5 h-4 w-4 shrink-0 text-champagne" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
						<circle cx="12" cy="10" r="3"></circle>
					</svg>
					<p class="text-sm text-sand/70">Calle 45 #12-34<br>Bogotá, Colombia</p>
				</div>
			</div>
		</div>

		<!-- Bottom bar -->
		<div class="mt-14 flex flex-col items-center justify-between gap-4 border-t border-pure/10 pt-8 md:flex-row">
			<p class="text-sm text-sand/50">
				© {new Date().getFullYear()} Centro Estético {siteName}. Todos los derechos reservados.
			</p>

			<!-- Back to top -->
			<button
				id="back-to-top"
				type="button"
				class="group inline-flex items-center gap-2 text-sm text-sand/50 transition-colors duration-300 hover:text-champagne"
				aria-label="Volver arriba"
			>
				Volver arriba
				<span class="flex h-8 w-8 items-center justify-center rounded-full border border-pure/10 transition-all duration-300 group-hover:border-champagne/40 group-hover:-translate-y-1">
					<svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="m18 15-6-6-6 6"></path>
					</svg>
				</span>
			</button>
		</div>
	</div>
</footer>

<script>
	const backToTop = document.getElementById('back-to-top');
	backToTop?.addEventListener('click', () => {
		window.scrollTo({ top: 0, behavior: 'smooth' });
	});
</script>
