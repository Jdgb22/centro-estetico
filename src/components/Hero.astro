---
interface Props {
	tagline?: string;
	title?: string;
	subtitle?: string;
	promoTitle?: string;
	promoDescription?: string;
	promoPrice?: string;
	promoNote?: string;
	promoLabel?: string;
	features?: string[];
}

const {
	tagline = 'Belleza consciente y resultados visibles',
	title = 'Realza tu belleza natural en un espacio de cuidado profesional',
	subtitle = 'Combinamos tecnología estética, técnicas especializadas y atención personalizada para que te sientas bien por dentro y por fuera.',
	promoTitle = 'Plan de bienvenida',
	promoDescription = 'Primera visita con diagnóstico facial + asesoría de rutina diaria.',
	promoPrice = '$39.900',
	promoNote = 'Cupos limitados para nuevas clientas.',
	promoLabel = 'Promoción del mes',
	features = [
		'Valoración personalizada sin costo adicional.',
		'Recomendación de tratamiento y frecuencia ideal.',
		'Seguimiento posterior de resultados.',
	],
} = Astro.props;
---

<section class="hero relative overflow-hidden bg-gradient-to-br from-sand via-ivory to-nude/20">
	<!-- Animated decorative orbs -->
	<div class="orb orb-1 absolute -top-32 -right-20 h-80 w-80 rounded-full bg-champagne/20 blur-3xl"></div>
	<div class="orb orb-2 absolute -bottom-24 -left-20 h-96 w-96 rounded-full bg-nude/25 blur-3xl"></div>
	<div class="orb orb-3 absolute top-1/2 left-1/3 h-48 w-48 rounded-full bg-terracotta/10 blur-3xl"></div>

	<!-- Decorative dots pattern -->
	<div class="absolute top-12 right-12 hidden opacity-20 md:block">
		<div class="grid grid-cols-5 gap-3">
			{Array.from({ length: 15 }).map(() => (
				<div class="h-1.5 w-1.5 rounded-full bg-champagne"></div>
			))}
		</div>
	</div>

	<div class="relative mx-auto grid max-w-6xl gap-12 px-6 py-24 md:grid-cols-2 md:items-center md:py-32 lg:gap-16">
		<!-- Left: Copy -->
		<div class="hero-content space-y-8">
			<p class="fade-up inline-flex items-center gap-2 rounded-full border border-champagne/30 bg-pure/70 px-5 py-2 text-sm font-medium text-champagne shadow-soft backdrop-blur-sm">
				<span class="flex h-2 w-2 rounded-full bg-champagne">
					<span class="inline-flex h-2 w-2 animate-ping rounded-full bg-champagne/60"></span>
				</span>
				{tagline}
			</p>

			<h1 class="fade-up font-heading text-4xl font-bold leading-tight tracking-tight text-mocha md:text-5xl lg:text-[3.4rem] lg:leading-[1.15]">
				{title}
			</h1>

			<p class="fade-up max-w-xl text-lg leading-relaxed text-taupe">
				{subtitle}
			</p>

			<div class="fade-up flex flex-wrap items-center gap-4">
				<a
					href="#servicios"
					class="group inline-flex items-center gap-2 rounded-full bg-champagne px-7 py-3.5 text-sm font-semibold text-pure shadow-soft transition-all duration-300 hover:-translate-y-0.5 hover:bg-terracotta hover:shadow-lg"
				>
					Ver tratamientos
					<svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M5 12h14"></path>
						<path d="m12 5 7 7-7 7"></path>
					</svg>
				</a>
				<a
					href="#contacto"
					class="group inline-flex items-center gap-2 rounded-full border border-champagne/50 px-7 py-3.5 text-sm font-semibold text-mocha transition-all duration-300 hover:border-champagne hover:bg-sand/50"
				>
					Solicitar evaluación
				</a>
			</div>

			<!-- Trust indicators -->
			<div class="fade-up flex items-center gap-6 pt-2">
				<div class="flex items-center gap-2">
					<div class="flex -space-x-2">
						<div class="flex h-8 w-8 items-center justify-center rounded-full border-2 border-ivory bg-sand text-xs font-semibold text-champagne">D</div>
						<div class="flex h-8 w-8 items-center justify-center rounded-full border-2 border-ivory bg-nude text-xs font-semibold text-pure">M</div>
						<div class="flex h-8 w-8 items-center justify-center rounded-full border-2 border-ivory bg-champagne text-xs font-semibold text-pure">V</div>
					</div>
					<p class="text-sm text-taupe"><span class="font-semibold text-mocha">+200</span> clientas satisfechas</p>
				</div>
			</div>
		</div>

		<!-- Right: Promo Card -->
		<div class="hero-card fade-up relative">
			<!-- Card glow effect -->
			<div class="absolute -inset-2 rounded-[32px] bg-gradient-to-br from-champagne/20 via-transparent to-nude/20 blur-xl"></div>

			<div class="relative overflow-hidden rounded-luxury border border-sand/50 bg-pure/85 p-8 shadow-xl backdrop-blur-sm md:p-10">
				<!-- Corner accent -->
				<div class="absolute -top-12 -right-12 h-32 w-32 rounded-full bg-champagne/10"></div>

				<div class="relative">
					<h2 class="font-heading text-2xl font-semibold text-mocha">{promoTitle}</h2>
					<p class="mt-3 leading-relaxed text-taupe">{promoDescription}</p>

					<!-- Price box -->
					<div class="mt-7 overflow-hidden rounded-2xl bg-gradient-to-br from-sand/80 to-sand/40 p-6">
						<p class="text-sm font-semibold uppercase tracking-wider text-champagne">{promoLabel}</p>
						<div class="mt-2 flex items-baseline gap-2">
							<p class="text-4xl font-bold text-mocha">{promoPrice}</p>
							<span class="text-sm text-taupe">/ sesión</span>
						</div>
						<p class="mt-2 text-sm text-terracotta">{promoNote}</p>
					</div>

					<!-- Features list -->
					<ul class="mt-7 space-y-3">
						{features.map((feature) => (
							<li class="flex items-start gap-3 text-sm text-taupe">
								<span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-champagne/15 text-champagne">
									<svg class="h-3 w-3" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
										<polyline points="20 6 9 17 4 12"></polyline>
									</svg>
								</span>
								{feature}
							</li>
						))}
					</ul>
				</div>
			</div>
		</div>
	</div>

	<!-- Bottom wave separator -->
	<div class="absolute bottom-0 left-0 w-full overflow-hidden leading-none">
		<svg class="relative block w-full" style="height: 40px" viewBox="0 0 1200 40" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
			<path d="M0,20 C300,40 900,0 1200,20 L1200,40 L0,40 Z" fill="var(--color-ivory)"></path>
		</svg>
	</div>
</section>

<style>
	/* Orb floating animation */
	.orb {
		animation: float 8s ease-in-out infinite;
	}
	.orb-2 {
		animation-delay: -3s;
		animation-duration: 10s;
	}
	.orb-3 {
		animation-delay: -5s;
		animation-duration: 12s;
	}

	@keyframes float {
		0%, 100% { transform: translate(0, 0) scale(1); }
		33% { transform: translate(15px, -20px) scale(1.05); }
		66% { transform: translate(-10px, 12px) scale(0.97); }
	}

	/* Fade-up entrance animation */
	.fade-up {
		opacity: 0;
		transform: translateY(24px);
		animation: fadeUp 0.7s ease-out forwards;
	}

	.fade-up:nth-child(1) { animation-delay: 0.1s; }
	.fade-up:nth-child(2) { animation-delay: 0.25s; }
	.fade-up:nth-child(3) { animation-delay: 0.4s; }
	.fade-up:nth-child(4) { animation-delay: 0.55s; }
	.fade-up:nth-child(5) { animation-delay: 0.65s; }

	.hero-card .fade-up {
		animation-delay: 0.5s;
	}

	@keyframes fadeUp {
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	/* Card subtle hover lift */
	.hero-card > div:last-child {
		transition: transform 0.4s ease, box-shadow 0.4s ease;
	}
	.hero-card:hover > div:last-child {
		transform: translateY(-4px);
		box-shadow:
			0 20px 40px rgba(58, 49, 43, 0.08),
			0 0 0 1px rgba(200, 169, 126, 0.1);
	}

	/* Reduce motion preference */
	@media (prefers-reduced-motion: reduce) {
		.orb { animation: none; }
		.fade-up {
			animation: none;
			opacity: 1;
			transform: none;
		}
		.hero-card > div:last-child {
			transition: none;
		}
	}
</style>
