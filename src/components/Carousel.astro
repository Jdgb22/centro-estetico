---
export interface Props {
  images?: { type?: 'image' | 'video'; src: string; alt?: string }[];
}

const { images = [
  { src: 'https://images.unsplash.com/photo-1615286591024-db0938b2c673?q=80&w=1200&auto=format&fit=crop', alt: 'Foto de Dra. Yuliana Giraldo' },
  { src: 'https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?q=80&w=1200&auto=format&fit=crop', alt: 'Masaje relajante' },
  { src: 'https://images.unsplash.com/photo-1560750588-73207b1ef5b8?q=80&w=1200&auto=format&fit=crop', alt: 'Instalaciones modernas' },
] } = Astro.props;
---

<div class="carousel-container relative w-full max-w-5xl mx-auto overflow-hidden rounded-2xl md:rounded-[2rem] shadow-xl shadow-sand/50 group">
  <div class="carousel-track flex transition-transform duration-700 ease-[cubic-bezier(0.25,1,0.5,1)] h-[500px] md:h-[600px] will-change-transform">
    {images.map((img, index) => (
      <div class="carousel-slide w-full shrink-0 flex-none relative bg-sand/20" style="flex: 0 0 100%;">
        {img.type === 'video' ? (
          <video 
            src={img.src} 
            class="absolute inset-0 w-full h-full object-cover carousel-video" 
            muted 
            playsinline 
            webkit-playsinline
          ></video>
        ) : (
          <img src={img.src} alt={img.alt || "Imagen del carrusel"} class="absolute inset-0 w-full h-full object-contain object-center transition-transform duration-[10s] group-hover:scale-105" loading={index === 0 ? "eager" : "lazy"} />
        )}
      </div>
    ))}
  </div>
  
  <button class="carousel-prev absolute left-4 md:left-6 top-1/2 -translate-y-1/2 w-12 h-12 rounded-full bg-pure/70 text-mocha flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-300 hover:bg-champagne hover:text-pure shadow-lg backdrop-blur-md hover:scale-110" aria-label="Anterior">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-6 h-6 ml-[-2px]">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
    </svg>
  </button>
  
  <button class="carousel-next absolute right-4 md:right-6 top-1/2 -translate-y-1/2 w-12 h-12 rounded-full bg-pure/70 text-mocha flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-300 hover:bg-champagne hover:text-pure shadow-lg backdrop-blur-md hover:scale-110" aria-label="Siguiente">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-6 h-6 mr-[-2px]">
      <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
    </svg>
  </button>

  <div class="carousel-indicators absolute bottom-6 left-1/2 -translate-x-1/2 flex gap-3 z-10">
    {images.map((_, index) => (
      <button class={`indicator h-2.5 rounded-full transition-all duration-300 ${index === 0 ? 'bg-champagne w-8' : 'bg-pure/60 w-2.5 hover:bg-pure'}`} data-index={index} aria-label={`Ir a la imagen ${index + 1}`}></button>
    ))}
  </div>
</div>

<script>
  class Carousel {
    container: HTMLElement;
    track: HTMLElement;
    slides: NodeListOf<HTMLElement>;
    nextBtn: HTMLButtonElement | null;
    prevBtn: HTMLButtonElement | null;
    indicators: NodeListOf<HTMLElement>;
    videos: NodeListOf<HTMLVideoElement>;
    
    currentIndex: number;
    totalSlides: number;
    
    isDragging: boolean;
    startX: number;
    currentX: number;
    autoPlayInterval?: number;
    isHovered: boolean;

    constructor(container: HTMLElement) {
      this.container = container;
      this.track = container.querySelector('.carousel-track') as HTMLElement;
      this.slides = container.querySelectorAll('.carousel-slide');
      this.nextBtn = container.querySelector('.carousel-next');
      this.prevBtn = container.querySelector('.carousel-prev');
      this.indicators = container.querySelectorAll('.indicator');
      this.videos = container.querySelectorAll('.carousel-video');
      
      this.currentIndex = 0;
      this.totalSlides = this.slides.length;
      
      // Para arrastrar (touch/swipe)
      this.isDragging = false;
      this.startX = 0;
      this.currentX = 0;
      this.isHovered = false;
      
      if (this.totalSlides > 1) {
        this.init();
      } else {
        // Si solo hay 1 slide, ocultar controles
        if(this.nextBtn) this.nextBtn.style.display = 'none';
        if(this.prevBtn) this.prevBtn.style.display = 'none';
        const indicatorsContainer = container.querySelector('.carousel-indicators') as HTMLElement | null;
        if (indicatorsContainer) indicatorsContainer.style.display = 'none';
      }
    }
    
    init() {
      if (this.nextBtn) this.nextBtn.addEventListener('click', () => { this.next(); this.startAutoPlay(); });
      if (this.prevBtn) this.prevBtn.addEventListener('click', () => { this.prev(); this.startAutoPlay(); });
      
      this.indicators.forEach((indicator, index) => {
        indicator.addEventListener('click', () => { this.goTo(index); this.startAutoPlay(); });
      });

      this.videos.forEach(video => {
        video.addEventListener('ended', () => {
          this.next();
          this.startAutoPlay();
        });
      });

      // Auto play
      this.updateUI(); // this will play the video if it's the first slide
      this.startAutoPlay();
      
      // Pause on hover
      this.container.addEventListener('mouseenter', () => {
        this.isHovered = true;
        this.stopAutoPlay();
      });
      this.container.addEventListener('mouseleave', () => {
        this.isHovered = false;
        this.startAutoPlay();
      });

      // Touch events
      if (this.track) {
        this.track.addEventListener('touchstart', (e) => this.touchStart(e as TouchEvent), { passive: true });
        this.track.addEventListener('touchmove', (e) => this.touchMove(e as TouchEvent), { passive: true });
        this.track.addEventListener('touchend', () => this.touchEnd());
      }
    }

    startAutoPlay() {
      this.stopAutoPlay();
      
      if (this.isHovered) return;

      const currentSlide = this.slides[this.currentIndex];
      const video = currentSlide.querySelector('.carousel-video') as HTMLVideoElement | null;
      
      if (video) {
        // El video controla el tiempo
        return;
      }

      // @ts-ignore
      this.autoPlayInterval = setTimeout(() => {
        this.next();
        this.startAutoPlay();
      }, 5000) as unknown as number;
    }

    stopAutoPlay() {
      if (this.autoPlayInterval) {
        clearTimeout(this.autoPlayInterval);
        this.autoPlayInterval = undefined;
      }
    }

    touchStart(e: TouchEvent) {
      this.isDragging = true;
      this.startX = e.touches[0].clientX;
      if (this.track) this.track.style.transition = 'none'; // Quitar transición suave durante el arrastre
      this.stopAutoPlay();
    }

    touchMove(e: TouchEvent) {
      if (!this.isDragging || !this.track) return;
      this.currentX = e.touches[0].clientX;
      const diff = this.currentX - this.startX;
      // Añadir resistencia al llegar a los bordes
      const offset = -this.currentIndex * 100 + (diff / this.container.offsetWidth) * 100;
      this.track.style.transform = `translateX(${offset}%)`;
    }

    touchEnd() {
      this.isDragging = false;
      if (this.track) this.track.style.transition = 'transform 0.7s cubic-bezier(0.25, 1, 0.5, 1)';
      
      const diff = this.currentX - this.startX;
      const threshold = 50; // pixels
      
      if (Math.abs(diff) > threshold) {
        if (diff > 0) {
          this.prev();
        } else {
          this.next();
        }
      } else {
        // Volver a la posición actual si no se movió suficiente
        this.updateUI();
      }
      
      this.startAutoPlay();
    }
    
    updateUI() {
      if (this.track) {
        this.track.style.transform = `translateX(-${this.currentIndex * 100}%)`;
      }
      
      this.indicators.forEach((indicator, index) => {
        if (index === this.currentIndex) {
          indicator.classList.remove('bg-pure/60', 'w-2.5');
          indicator.classList.add('bg-champagne', 'w-8');
        } else {
          indicator.classList.add('bg-pure/60', 'w-2.5');
          indicator.classList.remove('bg-champagne', 'w-8');
        }
      });

      // Handle videos
      this.videos.forEach(v => {
        v.pause();
        v.currentTime = 0;
      });

      const currentSlide = this.slides[this.currentIndex];
      const video = currentSlide.querySelector('.carousel-video') as HTMLVideoElement | null;
      if (video) {
        video.play().catch(e => console.error("Error playing video:", e));
      }
    }
    
    next() {
      this.currentIndex = (this.currentIndex + 1) % this.totalSlides;
      this.updateUI();
    }
    
    prev() {
      this.currentIndex = (this.currentIndex - 1 + this.totalSlides) % this.totalSlides;
      this.updateUI();
    }
    
    goTo(index: number) {
      this.currentIndex = index;
      this.updateUI();
    }
  }

  // Inicializar de manera segura en Astro (ViewTransitions)
  const initCarousels = () => {
    document.querySelectorAll('.carousel-container').forEach(el => {
      const container = el as HTMLElement;
      // Evitar inicializar dos veces
      if (!container.dataset.initialized) {
        new Carousel(container);
        container.dataset.initialized = 'true';
      }
    });
  };

  document.addEventListener('astro:page-load', initCarousels);
  // Llamar inmediatamente por si no usa view transitions
  initCarousels();
</script>
