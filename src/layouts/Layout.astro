---
import '../styles/global.css';
import CookieBanner from '../components/CookieBanner.astro';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Doctora Yuliana Giraldo | Medica estetica',
	description = 'Tratamientos faciales, corporales y de bienestar en un espacio profesional y acogedor.',
} = Astro.props;
---

<!doctype html>
<html lang="es" class="overflow-x-hidden scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/estetica.svg" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		
		<!-- Cabeceras de Seguridad Básicas (Punto 18) -->
		<meta http-equiv="X-Content-Type-Options" content="nosniff" />
		<meta http-equiv="Permissions-Policy" content="camera=(), microphone=(), geolocation=()" />
		<meta name="referrer" content="strict-origin-when-cross-origin" />
		
		<title>{title}</title>
	</head>
	<body class="bg-ivory text-mocha font-body antialiased">
		<div class="relative flex min-h-screen w-full max-w-[100vw] flex-col overflow-x-hidden">
		<slot />
			<CookieBanner />
		</div>
	</body>
</html>
